{
  "welcomeFile": "/odata/v4/flights/$metadata",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/mcp(.*)$",
      "target": "/mcp$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/odata/v4/flights/(.*)$",
      "target": "/odata/v4/flights/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    }
  ]
}
